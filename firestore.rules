rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.email is string &&
             data.role in ['MANAGER', 'CASHIER'];
    }

    function isValidProduct(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 &&
             data.category is string &&
             (!('totalStock' in data) || data.totalStock is number) &&
             (!('defaultSellingPriceIqd' in data) || data.defaultSellingPriceIqd is number);
    }

    function isValidVariant(data) {
      return data.userId == request.auth.uid &&
             data.productId is string &&
             data.size is string &&
             data.color is string &&
             (!('currentStock' in data) || data.currentStock is number) &&
             (!('sellingPriceIqd' in data) || data.sellingPriceIqd is number);
    }

    function isValidPurchaseBatch(data) {
      return data.userId == request.auth.uid &&
             data.batchNumber is string &&
             data.totalCostIqd is number && data.totalCostIqd >= 0;
    }

    function isValidPurchaseBatchItem(data) {
      return data.userId == request.auth.uid &&
             data.batchId is string &&
             data.variantId is string &&
             data.purchasedQty is number && data.purchasedQty > 0 &&
             data.remainingQty is number && data.remainingQty >= 0 &&
             data.unitCostIqd is number && data.unitCostIqd >= 0;
    }

    function isValidSale(data) {
      return data.userId == request.auth.uid &&
             data.invoiceNumber is string &&
             data.netAmountIqd is number && data.netAmountIqd >= 0;
    }

    function isValidSaleItem(data) {
      return data.userId == request.auth.uid &&
             data.saleId is string &&
             data.variantId is string &&
             data.quantity is number && data.quantity > 0 &&
             data.unitSalePriceIqd is number && data.unitSalePriceIqd >= 0;
    }

    function isValidExpense(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 &&
             data.amountIqd is number && data.amountIqd > 0;
    }

    function isValidStockMovement(data) {
      return data.userId == request.auth.uid &&
             data.variantId is string &&
             data.type in ['PURCHASE', 'SALE', 'ADJUSTMENT', 'RETURN'] &&
             data.quantityDelta is number;
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    // Products
    match /products/{productId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidProduct(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidProduct(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Variants
    match /variants/{variantId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidVariant(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidVariant(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Purchase Batches
    match /purchase_batches/{batchId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidPurchaseBatch(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidPurchaseBatch(request.resource.data);
      allow delete: if false;
    }

    // Purchase Batch Items (Historical costs must never be overwritten)
    match /purchase_batch_items/{itemId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidPurchaseBatchItem(request.resource.data);
      // Only remainingQty can be decremented by FIFO engine, historical unitCostIqd and purchasedQty are immutable
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
                      isValidPurchaseBatchItem(request.resource.data) &&
                      request.resource.data.unitCostIqd == resource.data.unitCostIqd &&
                      request.resource.data.purchasedQty == resource.data.purchasedQty;
      allow delete: if false;
    }

    // Sales
    match /sales/{saleId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidSale(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidSale(request.resource.data);
      allow delete: if false;
    }

    // Sale Items
    match /sale_items/{itemId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidSaleItem(request.resource.data);
      allow update: if false; // Historical sale items are immutable
      allow delete: if false;
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidExpense(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidExpense(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Stock Movements (Immutable audit log)
    match /stock_movements/{movementId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidStockMovement(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }
  }
}
